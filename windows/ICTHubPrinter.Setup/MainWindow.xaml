<Window x:Class="ICTHubPrinter.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="算法实验室 · 打印机" Width="860" Height="660" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Background="White" Foreground="#152C46" Icon="Assets/lab-logo.png">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#F0F4F8" Padding="28,36,28,28">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Image Source="Assets/lab-logo.png" Width="160" Height="160" Stretch="Uniform" Margin="0,0,0,22" AutomationProperties.Name="算法实验室 Logo"/>
          <TextBlock Text="算法实验室" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="让打印更简单" Foreground="#63768A" Margin="0,9,0,30" HorizontalAlignment="Center"/>
          <Border Height="1" Background="#D9E2EB"/>
          <TextBlock Text="惠普打印机" FontSize="16" FontWeight="SemiBold" Margin="0,25,0,10"/>
          <TextBlock Text="实验室内网优先&#x0a;校外也能连接打印&#x0a;使用 Windows 自带驱动" Foreground="#63768A" LineHeight="27"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Button x:Name="StatusButton" Content="打印机状态" Click="Status_Click" Background="#E0E8F0" Foreground="#102F52" Margin="0,0,0,8"/>
          <Button x:Name="UninstallButton" Content="卸载打印机" Click="Uninstall_Click" Background="Transparent" Foreground="#63768A" Padding="12,8"/>
          <TextBlock Text="Windows 10 / 11 · RC3" Foreground="#7C8A99" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="38,40,38,28">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock x:Name="StepText" Text="开始使用" Foreground="#8C7239" FontSize="12" Margin="0,0,0,12"/>
        <TextBlock x:Name="Heading" FontSize="28" FontWeight="SemiBold" Text="安装实验室打印机"/>
        <TextBlock x:Name="Description" Foreground="#63768A" LineHeight="24" Margin="0,14,0,24"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <StackPanel x:Name="UsernamePanel" Visibility="Collapsed" Margin="0,0,0,16">
            <Label Content="账号或邮箱" Target="{Binding ElementName=Username}" Padding="0,0,0,8"/>
            <TextBox x:Name="Username" MaxLength="254" AutomationProperties.Name="账号或邮箱"/>
          </StackPanel>
          <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,0,0,16">
            <Label Content="密码" Target="{Binding ElementName=Password}" Padding="0,0,0,8"/>
            <PasswordBox x:Name="Password" MaxLength="4096" AutomationProperties.Name="密码"/>
          </StackPanel>
          <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,0,0,16">
            <Label Content="动态验证码或恢复码" Target="{Binding ElementName=Code}" Padding="0,0,0,8"/>
            <PasswordBox x:Name="Code" MaxLength="128" AutomationProperties.Name="动态验证码或恢复码"/>
          </StackPanel>
          <Border x:Name="DetailPanel" Background="#F4F7FA" CornerRadius="8" Padding="18" Visibility="Collapsed" Margin="0,0,0,18">
            <TextBlock x:Name="Details" LineHeight="25"/>
          </Border>
          <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="5" Visibility="Collapsed" Foreground="#B99138" Background="#EEF2F6" Margin="0,0,0,14"/>
          <TextBlock x:Name="ProgressText" Foreground="#63768A" LineHeight="23" Margin="0,0,0,10"/>
          <TextBlock x:Name="ErrorText" Foreground="#AA3535" LineHeight="23" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,24,0,0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="Primary" Content="登录并继续" Click="Primary_Click" IsDefault="True" MinWidth="146"/>
          <Button x:Name="Secondary" Content="返回" Click="Secondary_Click" Background="#EDF1F5" Foreground="#435870" Margin="12,0,0,0"/>
        </StackPanel>
        <Button x:Name="SavedLogin" Content="使用本机已登录账号" Click="SavedLogin_Click" Background="Transparent" Foreground="#526D89" HorizontalAlignment="Left" Padding="0,12" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
