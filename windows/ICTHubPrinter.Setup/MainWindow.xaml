<Window x:Class="ICTHubPrinter.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="算法与科研实验室 · 打印机" Width="840" Height="610" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="24">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,34">
            <Image Source="Assets/lab-logo.png" Width="36" Height="36" Stretch="Uniform" Margin="0,0,10,0" AutomationProperties.Name="算法与科研实验室 Logo"/>
            <TextBlock Text="算法与科研实验室" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="18" Height="18" Fill="{DynamicResource Ink}" Margin="0,0,8,0">
              <Rectangle.OpacityMask><ImageBrush ImageSource="Assets/printer.png" Stretch="Uniform"/></Rectangle.OpacityMask>
            </Rectangle>
            <TextBlock Text="惠普打印机" FontSize="14" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock Text="DeskJet 4900" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,5,0,18"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Ellipse x:Name="DeviceStatusDot" Width="6" Height="6" Fill="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="DeviceStatusLabel" Text="读取中" FontSize="13"/>
          </StackPanel>
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,16"/>
          <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="纸张" Foreground="{DynamicResource Muted}" FontSize="12"/>
            <TextBlock x:Name="PaperStatusLabel" Grid.Column="1" Text="—" FontSize="12"/>
          </Grid>
          <ItemsControl x:Name="SupplyList" ToolTip="墨量为设备估计值">
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel Margin="0,0,0,18">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12"/>
                </Grid>
                <Grid Height="3" Background="{DynamicResource Track}" ClipToBounds="True">
                  <Rectangle Fill="{Binding Brush}" HorizontalAlignment="Left" Width="{Binding Width}"/>
                </Grid>
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="LastUpdated" Foreground="{DynamicResource Faint}" FontSize="11"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="-10,16,-10,0">
          <Button x:Name="StatusButton" Content="本机状态" Click="Status_Click" Style="{StaticResource QuietButton}"/>
          <Button x:Name="UninstallButton" Content="卸载打印机" Click="Uninstall_Click" Style="{StaticResource QuietButton}"/>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" Margin="44,36" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch">
      <StackPanel MaxWidth="408" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" FontSize="26" FontWeight="SemiBold" Text="安装打印机" Margin="0,0,0,26"/>
        <TextBlock x:Name="Description" Foreground="{DynamicResource Muted}" LineHeight="22" Margin="0,-12,0,24" Visibility="Collapsed"/>
        <StackPanel x:Name="UsernamePanel" Visibility="Collapsed" Margin="0,0,0,18">
          <Label Content="账号或邮箱" Target="{Binding ElementName=Username}" Padding="0,0,0,7"/>
          <TextBox x:Name="Username" MaxLength="254" AutomationProperties.Name="账号或邮箱"/>
        </StackPanel>
        <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,0,0,18">
          <Label Content="密码" Target="{Binding ElementName=Password}" Padding="0,0,0,7"/>
          <PasswordBox x:Name="Password" MaxLength="4096" AutomationProperties.Name="密码"/>
        </StackPanel>
        <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,0,0,18">
          <Label Content="动态验证码或恢复码" Target="{Binding ElementName=Code}" Padding="0,0,0,7"/>
          <PasswordBox x:Name="Code" MaxLength="128" AutomationProperties.Name="动态验证码或恢复码"/>
        </StackPanel>
        <Border x:Name="DetailPanel" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="16" Visibility="Collapsed" Margin="0,0,0,18">
          <TextBlock x:Name="Details" LineHeight="25" FontSize="13"/>
        </Border>
        <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="2" Visibility="Collapsed" Foreground="{DynamicResource Muted}" Background="{DynamicResource Line}" Margin="0,0,0,12"/>
        <TextBlock x:Name="ProgressText" Foreground="{DynamicResource Muted}" LineHeight="22" FontSize="12"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" LineHeight="22" FontSize="13" AutomationProperties.LiveSetting="Assertive"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button x:Name="Primary" Content="登录" Click="Primary_Click" IsDefault="True" MinWidth="108"/>
          <Button x:Name="Secondary" Content="返回" Click="Secondary_Click" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource LineStrong}" Foreground="{DynamicResource Muted}" Margin="10,0,0,0"/>
        </StackPanel>
        <Button x:Name="SavedLogin" Content="使用已登录账号" Click="SavedLogin_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,10" Margin="0,6,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
